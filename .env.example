# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── BIG-IP ────────────────────────────────────────────────────────────────────
# The UDF HTTPS access-method hostname does NOT work here. It is authenticated
# by the browser session cookie, so a scripted call gets UDF's HTML login page
# with a 401 — never BIG-IP. (An earlier note in this file claimed otherwise
# based on the status code alone; the response BODY disproves it.)
#
# Pick one:
#   A. SSH tunnel, tools stay on your laptop:
#        ssh -p <sshPort> -N -L 8443:<bigip-mgmt-ip>:443 <user>@<dnsKey>.access.udf.f5.com
#      then:
#        BIGIP_HOST=https://127.0.0.1:8443
#   B. Run the tools inside the deployment (api-backend / test-desktop), where
#      the 10.1.1.0/24 management subnet is directly reachable:
#        BIGIP_HOST=https://10.1.1.<bigip>
BIGIP_HOST=https://127.0.0.1:8443
BIGIP_USERNAME=admin
# From the bigip-waf component's Credentials tab in UDF — templates ship their
# own credential, it is not admin/admin. Put it HERE rather than `export`ing it:
# zsh expands $ ! and backticks, this file is not expanded, and a shell variable
# would silently shadow this one (see tools/check_env.py).
BIGIP_PASSWORD=changeme

# ── Lab topology (traffic subnet 10.1.10.0/24) ────────────────────────────────
# Every tool reads these, so the harness re-targets to any lab by editing .env.
VS_JWE_INGRESS=10.1.10.40              # decrypt -> chain to WAF   (the fix)
VS_JWE_BLIND=10.1.10.41                # WAF only, no decrypt      (the blind spot)
VS_PLAIN_WAF=10.1.10.42                # plaintext + WAF           (policy is armed)
VS_JWE_SINGLE=10.1.10.43               # optional: decrypt+WAF same VS
BACKEND_IP=10.1.10.20
BACKEND_PORT=8080

# ── JWE key material ──────────────────────────────────────────────────────────
JWE_KEYS_DIR=./keys                    # local generation target
BIGIP_KEYS_DIR=/config/jwe/keys        # where ilx_deploy.py installs them
JWKS_URL=https://10.1.10.20:8080/.well-known/jwks.json

# ── Behaviour ─────────────────────────────────────────────────────────────────
JWE_FAIL_MODE=closed                   # closed | open  (open is a WAF bypass — test only)
JWE_MAX_PAYLOAD=65536                  # ILX::call hard cap
